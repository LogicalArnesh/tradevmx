# ==========================================================================
# TradeXVm - environment template.  Copy to `.env` and fill in.
# Never commit `.env`.  All values below are read by config.py.
# ==========================================================================

# ---------------------------------------------------------------- Telegram
# From @BotFather.  The bot must be started by every chat you list below.
TELEGRAM_BOT_TOKEN=
# Comma / space separated chat ids (personal id, group id or channel id).
# Groups and channels are usually negative, e.g. -1001234567890.
TELEGRAM_CHAT_IDS=

# ------------------------------------------------------------------- Email
# Gmail SMTP with a 16-character App Password (Google Account -> Security ->
# 2-Step Verification -> App passwords).  Your normal password will NOT work.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Comma separated recipients.  Defaults to GMAIL_USER when empty.
EMAIL_RECIPIENTS=
ENABLE_EMAIL=true

# -------------------------------------------------------------------- Groq
# https://console.groq.com/keys  (free tier is sufficient for a desk bot)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=45
# When no key is configured the desk falls back to deterministic ATR plans.

# --------------------------------------------------------------- Watchlist
# NSE equities only.  `^NSEI` (NIFTY 50) and `^NSEBANK` (BANK NIFTY) are
# always scanned and do not need to be listed here.
WATCHLIST=RELIANCE.NS,HDFCBANK.NS,ICICIBANK.NS,TCS.NS,INFY.NS,SBIN.NS,LT.NS,AXISBANK.NS,BHARTIARTL.NS,MARUTI.NS

# ------------------------------------------------------------- Scan engine
SCAN_INTERVAL_MINUTES=15
SCAN_TIMEFRAME=15m
CONFIRM_TIMEFRAME=5m
SCAN_WORKERS=4
SNAPSHOT_TTL_SECONDS=60
ENABLE_NSE_LIVE=true
NSE_TIMEOUT_SECONDS=6

# -------------------------------------------------------------- Detectors
VOLUME_SMA_PERIOD=10
VOLUME_SURGE_MULTIPLE=1.5
OB_DISPLACEMENT_ATR=1.4
OB_LOOKBACK_BARS=160
OB_RETEST_TOLERANCE_ATR=0.35
SWING_FRACTAL_BARS=2

# -------------------------------------------------------------- Alerting
ALERT_MIN_SEVERITY=3
EMAIL_MIN_SEVERITY=4
ALERT_COOLDOWN_MINUTES=45

# ------------------------------------------------------------------- Risk
MIN_RISK_REWARD=2.0

# --------------------------------------------------------------- Schedule
# Scheduled in Asia/Kolkata.  The bot additionally gates every job with a
# market-hours check, so a cron hit at 09:00 or 15:45 is a no-op.
EOD_WRAP_TIME=15:40
OPENING_BRIEF_TIME=09:16
# NSE trading holidays, YYYY-MM-DD.  Update this list each year.
MARKET_HOLIDAYS=

# ---------------------------------------------------------- Desktop console
# Local app port (the launcher picks the next free port if this is taken).
APP_PORT=8765
DESKTOP_TOAST=true
# Spoken alert headlines - requires: pip install pyttsx3
VOICE_ALERTS=false

# ----------------------------------------------------------------- Output
REPORT_DIR=reports
LOG_DIR=logs
LOG_LEVEL=INFO
